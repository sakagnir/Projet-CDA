{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/nav.css') }}">
{% endblock %}

<nav class="header">
	<div class="logo">
		<a href="{{ path('app_home')}}" class="logo">
			<img src="{{ asset('images/logo_gestion_rendezvous.svg') }}" alt="Logo"/>
		</a>
	</div>
	<button type="button" class="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-links">
		<span></span>
		<span></span>
		<span></span>
	</button>
	<div class="nav_link" id="nav-links">
		<div class="row">
			{% if app.user %}
				{% if not app.user.business %}
					<a href="{{ path('app_add_business') }}">Créer un commerce</a>
				{% endif %}
				<a href="{{ path('app_all_business') }}">Commerces</a>
				<a href="{{ path('app_profile') }}">Profil</a>
				<a href="{{ path('app_logout') }}">Déconnexion</a>
			{% else %}
				<a href="{{ path('app_login') }}">Connexion</a>
				<a href="{{ path('app_register') }}">Inscription</a>
			{% endif %}
		</div>
	</div>
</nav>

{% block javascripts %}
	<script src="{{ asset('js/nav.js') }}" defer></script>
{% endblock %}
