{% extends 'base.html.twig' %}

{% block title %}
    Profil
{% endblock %}

{% block breadcrumb %}
	{% include 'component/breadcrumb.html.twig' with {items: [
		{label: 'Accueil', route: 'app_home'},
		{label: 'Profil'}
	]} %}
{% endblock %}

{% block main %}
	<main>
		<h2>Profil</h2>

		{% for flash_success in app.flashes('success') %}
			<div class="alert alert-success" role="alert">{{ flash_success }}</div>
		{% endfor %}

		{{ form_errors(profileForm) }}

		{{ form_start(profileForm) }}
		{{ form_row(profileForm.lastName) }}
		{{ form_row(profileForm.firstName) }}
		{{ form_row(profileForm.email) }}
		{{ form_row(profileForm.phoneNumber) }}

		<button type="submit" class="btn">Enregistrer</button>
		{{ form_end(profileForm) }}

		{% for flash_error in app.flashes('error') %}
			<div class="alert alert-danger">{{ flash_error }}</div>
		{% endfor %}

		<h3>Supprimer mon compte</h3>
		<p>Cette action est irréversible.</p>
		<form method="post" action="{{ path('app_delete_user') }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible.');">
			<input type="hidden" name="_token" value="{{ csrf_token('delete-user') }}">
			<button type="submit" class="btn btn-danger">Supprimer mon compte</button>
		</form>
	</main>
{% endblock %}
