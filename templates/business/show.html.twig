{% extends 'base.html.twig' %}

{% block title %}
	{{ business.name }}
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/business/show.css') }}">
{% endblock %}

{% block main %}
	<main>
		<div class="container">
			{% set flash_success = app.flashes('success')|last %}
			{% if flash_success %}
				<div class="alert alert-success" role="alert">{{ flash_success }}</div>
			{% endif %}
			{% set flash_error = app.flashes('error')|last %}
			{% if flash_error %}
				<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
			{% endif %}

			<h2>{{ business.name }}</h2>
			<p class="business-address">{{ business.address }}</p>
			<p>{{ business.description }}</p>

			<h3>Créneaux disponibles</h3>

			<form class="availability-search" method="get">
				<label for="from">À partir du</label>
				<input type="date" id="from" name="from" value="{{ from ? from|date('Y-m-d') : '' }}">
				<button type="submit">Rechercher</button>
			</form>

			{% if app.user and business.manager and business.manager.id == app.user.id %}
				<a href="{{ path('app_add_availability', {id: business.id}) }}">Ajouter un créneau</a>
			{% endif %}

			{% if availabilities is empty %}
				<p>Aucun créneau disponible.</p>
			{% else %}
				<ul class="availability-list">
					{% for availability in availabilities %}
						<li>
							<div>
								{{ availability.startDate|date('d/m/Y H:i') }}
								-
								{{ (availability.startDate.timestamp + 3600)|date('H:i') }}
							</div>
							<a href="{{path('app_book_availability', {id: availability.id})}}">Réserver</a>
						</li>

					{% endfor %}
				</ul>
			{% endif %}
		</div>
	</main>
{% endblock %}
