{% extends 'base.html.twig' %}

{% block title %}
    Commerces
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('css/business/list.css') }}">
{% endblock %}

{% block main %}
	<main>
		<div class="container">
			<form class="business-search" method="get" action="{{ path('app_all_business') }}">
				<label for="q">Rechercher un commerce</label>
				<input type="text" id="q" name="q" value="{{ query }}" placeholder="Nom ou adresse">
				<button type="submit">Rechercher</button>
				{% if query %}
					<a href="{{ path('app_all_business') }}">Réinitialiser</a>
				{% endif %}
			</form>

			{% if query %}
				<p class="business-search-result">Résultats pour « {{ query }} »</p>
			{% endif %}

			{% if businesses is empty %}
				<p>Aucun commerce trouvé{{ query ? ' pour « ' ~ query ~ ' »' : '' }}.</p>
			{% else %}
				<div class="business-grid">
					{% for business in businesses %}
						<a class="business-card" href="{{ path('app_show_business', {id: business.id}) }}">
							<h3>{{ business.name }}</h3>
							<p>{{ business.description }}</p>
						</a>
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</main>
{% endblock %}
